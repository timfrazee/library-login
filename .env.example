# Copy to .env for local development. Values here are loaded at startup only if
# the variable isn't already set in your real environment (real env and the
# -data flag still win).

# Keep the database in the current working directory (handy for dev):
LIBRARY_LOGIN_LOCAL=1

# Or pin an explicit data directory (takes precedence over LIBRARY_LOGIN_LOCAL):
# LIBRARY_LOGIN_DATA=/absolute/path/to/data

# Serve the whole LAN so other devices (e.g. locked Chromebooks) can reach it.
# LIBRARY_LOGIN_LAN=1
# Or bind a specific address (takes precedence over LIBRARY_LOGIN_LAN):
# LIBRARY_LOGIN_HOST=0.0.0.0
